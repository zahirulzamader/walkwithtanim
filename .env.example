# =============================================
# Walk With Tanim — Environment Variables
# Copy this file to .env and fill in your values
# =============================================

# --- Database (REQUIRED) ---
# Free PostgreSQL options: https://neon.tech  or  https://supabase.com
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# --- Admin Journal Password (REQUIRED) ---
# Set any password you want — this is what you use to unlock "Write Your Story"
JOURNAL_PASSCODE=your-secret-password-here

# --- AWS S3 for Photo Uploads (REQUIRED for journal photo uploads) ---
# Create a free AWS account → S3 → create a bucket → create IAM user with S3 access
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_FOLDER_PREFIX=walkwithtanim/

# --- Email Notifications (OPTIONAL) ---
# Contact form still saves to the database without these.
# These only work when hosted on Abacus.AI platform.
ABACUSAI_API_KEY=
WEB_APP_ID=
NOTIF_ID_CONTACT_FORM_SUBMISSION=
